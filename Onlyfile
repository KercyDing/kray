!version 0.5

[help] Build the project.
[pass] Build complete.
[fail] Build failed.
build():
    cmake --preset default
    cmake --build --preset default

[help] Run the built program.
[fail] Program failed.
run()
    ? @os("windows")
    & build
    shell~=pwsh
:
    .\build\kray.exe

run() & build:
    ./build/kray

[help] Format files with clang-format.
[pass] Formatting complete.
[fail] Formatting failed.
fmt() ? @os("windows") shell~=pwsh:
    | $exts = 'cpp', 'cc', 'cxx', 'cppm', 'h', 'hpp'
    | foreach ($e in $exts) { Get-ChildItem -Path src, include -Recurse -File -Filter "*.$e" | ForEach-Object { clang-format -i $_.FullName } }

fmt() shell~=bash:
    | exts="cpp cc cxx cppm h hpp"
    | for e in $exts; do find src include -type f -name "*.$e" -exec clang-format -i {} +; done

[help] Clean build outputs.
[pass] Cleaning complete.
[fail] Cleaning failed.
clean():
    rm -rf build *.ppm
