!version 0.5

[help] Configure the CMake build.
[pass] CMake configuration complete.
[fail] CMake configuration failed.
config():
    cmake --preset default

[help] Build the project.
[pass] Build complete.
[fail] Build failed.
build() & config:
    cmake --build --preset default

[help] Run the built program.
[fail] Program failed.
run()
    ? @os("windows")
    & build
    shell~=pwsh
:
    .\build\kray.exe

run() & build:
    ./build/kray

[help] Format files with clang-format.
[pass] Formatting complete.
[fail] Formatting failed.
fmt() & config:
    cmake --build --preset default --target format

[help] Clean build outputs.
[pass] Cleaning complete.
[fail] Cleaning failed.
clean():
    rm -rf build *.ppm
