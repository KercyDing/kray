!version 0.5

[help] Build the project.
[pass] Build complete.
[fail] Build failed.
build():
    cmake --preset default
    cmake --build --preset default

[help] Build the project with release optimizations.
[pass] Release build complete.
[fail] Release build failed.
build-release():
    cmake --preset release
    cmake --build --preset release

[help] Run the built program.
[fail] Program failed.
run()
    ? @os("windows")
    & build
    shell~=pwsh
:
    .\build\kray.exe

run() & build:
    ./build/kray

[help] Run the release build.
[fail] Program failed.
run-release()
    ? @os("windows")
    & build-release
    shell~=pwsh
:
    .\build-release\kray.exe

run-release() & build-release:
    ./build-release/kray

[help] Format files with clang-format.
[pass] Formatting complete.
[fail] Formatting failed.
fmt() ? @os("windows") shell~=pwsh:
    | $exts = 'cpp', 'cc', 'cxx', 'cppm', 'h', 'hpp'
    | $dirs = 'src', 'include'
    |
    | $present = $dirs | Where-Object { Test-Path $_ }
    | foreach ($e in $exts) {
    |     foreach ($d in $present) {
    |         Get-ChildItem -Path $d -Recurse -File -Filter "*.$e" | ForEach-Object { clang-format -i $_.FullName }
    |     }
    | }

fmt() shell~=bash:
    | exts="cpp cc cxx cppm h hpp"
    | dirs="src include"
    |
    | for e in $exts; do
    |     for d in $dirs; do
    |         if [ -d "$d" ]; then
    |             find "$d" -type f -name "*.$e" -exec clang-format -i {} +;
    |         fi
    |     done
    | done

[help] Clean build outputs.
[pass] Cleaning complete.
[fail] Cleaning failed.
clean():
    rm -rf build build-release *.ppm
