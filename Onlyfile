[help] Format files with clang-format.
[pass] Formatting complete.
[fail] Formatting failed.
fmt() ? @os("windows") shell~=pwsh:
    | $exts = 'cpp', 'cppm'
    |
    | foreach ($e in $exts) {
    |     Get-ChildItem -Path src -Recurse -File -Filter "*.$e" | ForEach-Object { clang-format -i $_.FullName }
    | }

fmt() shell~=bash:
    | exts="cpp cppm"
    |
    | for e in $exts; do
    |     find src -type f -name "*.$e" -exec clang-format -i {} +;
    | done

